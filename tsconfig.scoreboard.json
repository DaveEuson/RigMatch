{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scoreboard.tsbuildinfo",
    "target": "es2023",
    /* A Cloudflare Worker has the web's APIs (fetch, crypto, streams) and none
       of Node's, so no Node types: using one is a type error here. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode: wrangler bundles worker.ts with esbuild. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scoreboard"]
}
