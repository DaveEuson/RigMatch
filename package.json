{
  "name": "rigmatch-ai",
  "private": true,
  "version": "0.6.0",
  "packageManager": "npm@10.9.3",
  "description": "Find the best AI model your computer can run, 100% locally",
  "author": "Dave Euson <daveeuson@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node electron/launch.cjs\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "setup": "npm install && npm --prefix rigmatch-chat install",
    "build:chat": "npm --prefix rigmatch-chat install --no-audit --no-fund && npm --prefix rigmatch-chat run tauri:build",
    "prepare:companions": "node scripts/prepare-companions.cjs",
    "start": "node electron/launch.cjs",
    "dist": "npm run build && npm run build:chat && npm run prepare:companions && electron-builder",
    "dist:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && npm run build:chat && npm run prepare:companions && electron-builder --win",
    "dist:mac": "npm run build && npm run build:chat && npm run prepare:companions && electron-builder --mac",
    "dist:linux": "npm run build && npm run build:chat && npm run prepare:companions && electron-builder --linux",
    "pack:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && npm run build:chat && npm run prepare:companions && electron-builder --dir --win",
    "pack:mac": "npm run build && npm run build:chat && npm run prepare:companions && electron-builder --dir --mac",
    "pack:linux": "npm run build && npm run build:chat && npm run prepare:companions && electron-builder --dir --linux",
    "benchmark:ollama": "node scripts/benchmark-ollama.mjs",
    "compare:ollama-speed": "node scripts/compare-ollama-speed.mjs",
    "smoke:bench": "node scripts/smoke-benchmark.mjs",
    "smoke:bench:strict": "node scripts/smoke-benchmark.mjs --strict",
    "smoke:ui": "node scripts/visual-smoke.mjs",
    "release:notes": "node scripts/build-release-notes.mjs",
    "release:notes:check": "node scripts/build-release-notes.mjs --check",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "pack:win:local": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && npm run build:chat && npm run prepare:companions && electron-builder --dir --win --config.win.signAndEditExecutable=false",
    "sweep": "node scripts/release-sweep.mjs",
    "sweep:net": "node scripts/release-sweep.mjs --net",
    "gates": "node scripts/gate-download.mjs && node scripts/gate-provider.mjs",
    "audit:claims": "node scripts/audit-claims.mjs",
    "audit:screens": "node scripts/audit-screens.mjs",
    "sweep:layout": "node scripts/responsive-sweep.mjs",
    "sweep:shell": "node scripts/measure-shell.mjs"
  },
  "build": {
    "appId": "ai.rigmatch.app",
    "productName": "RigMatch",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "companions",
        "to": "companions"
      }
    ],
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RigMatch",
      "include": "build/installer.nsh"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "afterPack": "./scripts/afterPack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 180,
          "y": 240,
          "type": "file"
        },
        {
          "x": 480,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 180,
          "y": 430,
          "type": "file",
          "name": "RigMatch Chat.app"
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "DaveEuson",
      "repo": "RigMatch"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "systeminformation": "^5.31.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.8.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
